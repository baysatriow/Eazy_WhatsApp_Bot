# Nomor internasional tanpa +, spasi, atau tanda baca; pisahkan dengan koma.
# Kosong atau satu entri tidak valid menonaktifkan seluruh perintah.
BOT_ALLOWED_NUMBERS=
# Opsional: ID grup dipisahkan koma. Kosong berarti semua grup akun bot.
BOT_ALLOWED_GROUPS=
BOT_GROUP_REQUIRE_MENTION=true
BOT_TAG_ALL_ENABLED=false
BOT_TIME_ZONE=Asia/Jakarta
BOT_DATABASE_PATH=data/eazy-whatsapp-bot.sqlite
BOT_LOG_INCOMING=true
